{
    "name": "safehiring/sucrets-client",
    "description": "Demo client for the sucrets credentials service",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "defuse/php-encryption": "^2.4",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/console": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "SucretsClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SucretsClient\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/demo"],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": ["@cs", "@phpstan", "@test"]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11"
    }
}
